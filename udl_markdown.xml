<!-- @author Kristoffer Bernssen -->
<!-- Markdown-parser for Function List -->
<!--
    NOTATER:
    Denne parseren brukes i Notepad++ 8.9.8.1.

    - Gjenkjenner Markdown-overskrifter (# til ######).
    - Gjenkjenner Query, Resources og Code Example.
    - Brukes til navigering i Function List.
-->
