
<?xml version="1.0" encoding="UTF-8"?>
<NotepadPlus>
    <functionList>
        <parser
            id="Markdown (preinstalled)"
            displayName="Markdown Navigation"
            commentExpr="">

            <function
                mainExpr="(?m-s)^(?:[ \t]{0,3}#{1,6}[ \t]+[^\r\n]+|[^\r\n]*\S[^\r\n]*(?=\r?\n[ \t]{0,3}(?:={1,}|-{1,})[ \t]*(?:\r?\n|$))|[ \t]{0,3}\*\*(?:Query|Key Takeaways|Code Example|Resources):\*\*[ \t]*[^\r\n]*|[ \t]{0,3}`{3,}[^\r\n]*)"
            />

        </parser>
    </functionList>
</NotepadPlus>
